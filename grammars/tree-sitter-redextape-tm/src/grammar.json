{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "redextape_tm",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_line"
      }
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "tapes"
        },
        {
          "type": "SYMBOL",
          "name": "start"
        },
        {
          "type": "SYMBOL",
          "name": "_directive"
        },
        {
          "type": "SYMBOL",
          "name": "tape"
        },
        {
          "type": "SYMBOL",
          "name": "state"
        }
      ]
    },
    "tapes": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "tapes"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "start": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "start"
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        }
      ]
    },
    "_directive": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "version"
        },
        {
          "type": "SYMBOL",
          "name": "encoding"
        },
        {
          "type": "SYMBOL",
          "name": "width"
        },
        {
          "type": "SYMBOL",
          "name": "slots"
        },
        {
          "type": "SYMBOL",
          "name": "result"
        }
      ]
    },
    "version": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "version"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "encoding": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "encoding"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        }
      ]
    },
    "width": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "width"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "slots": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "slots"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "result": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "result"
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        }
      ]
    },
    "tape": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "tape"
        },
        {
          "type": "FIELD",
          "name": "index",
          "content": {
            "type": "SYMBOL",
            "name": "number"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "cells",
              "content": {
                "type": "SYMBOL",
                "name": "identifier"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "state": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "state"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "accept"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "rule"
              }
            }
          ]
        }
      ]
    },
    "rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "read",
          "content": {
            "type": "SYMBOL",
            "name": "group"
          }
        },
        {
          "type": "STRING",
          "value": "->"
        },
        {
          "type": "STRING",
          "value": "write"
        },
        {
          "type": "FIELD",
          "name": "write",
          "content": {
            "type": "SYMBOL",
            "name": "group"
          }
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": "move"
        },
        {
          "type": "FIELD",
          "name": "move",
          "content": {
            "type": "SYMBOL",
            "name": "move_group"
          }
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": "goto"
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        }
      ]
    },
    "group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "symbol"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "move_group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "head_move"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "symbol": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "SYMBOL",
          "name": "_symbol_char"
        }
      ]
    },
    "_symbol_char": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\s;*:\\[\\]]"
      }
    },
    "head_move": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[LRS]"
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9]+"
      }
    },
    "identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\s;*:\\[\\]]+"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": ";"
          },
          {
            "type": "PATTERN",
            "value": "[^\\n]*"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r\\n]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}
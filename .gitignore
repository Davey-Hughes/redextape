# Rust
/target/
**/target/
**/*.rs.bk

# WebAssembly build output (wasm-pack / wasm-bindgen / trunk)
/pkg/
**/pkg/
*.wasm

# Web frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# Vitest browser-mode artifacts. Written only when a browser test FAILS, so they are absent on a
# green tree and would otherwise be committed by whoever happens to run the suite after a red one.
.vitest-attachments/
**/__screenshots__/

# Environment & secrets
.env
.env.*
!.env.example

# Logs, editor, OS cruft
*.log
.DS_Store
.idea/

# Agent worktrees
/.claude/worktrees/

# Playwright MCP session output — screenshots and page snapshots from browser-driving tools.
# Never source; regenerated on demand and easily swept in by `git add -A`.
.playwright-mcp/
# ...and stray screenshots a browser tool wrote to a relative path outside it.
redextape-*.png

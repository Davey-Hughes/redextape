;; example-map-fold
;; source:
;;   fn map(xs, f) {
;;       if is_empty(xs) {
;;           nil
;;       } else {
;;           cons(f(head(xs)), map(tail(xs), f))
;;       }
;;   }
;;   fn fold(xs, acc, f) {
;;       if is_empty(xs) {
;;           acc
;;       } else {
;;           fold(tail(xs), f(acc, head(xs)), f)
;;       }
;;   }
;;   fn add(a, b) {
;;       a + b
;;   }
;;   fn add1(x) {
;;       x + 1
;;   }

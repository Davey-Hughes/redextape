{
  "name": "redextape-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/redextape-wasm --release --target web --out-dir ../../pkg",
    "build:wasm:dev": "wasm-pack build ../crates/redextape-wasm --dev --target web --out-dir ../../pkg",
    "build:lsp-wasm": "wasm-pack build ../crates/redextape-lsp-wasm --release --target web --out-dir ../../pkg-lsp",
    "build:clif-wasm": "wasm-pack build ../crates/redextape-clif-wasm --release --target web --out-dir ../../pkg-clif",
    "build:mc-x86-wasm": "wasm-pack build ../crates/redextape-mc-wasm --release --target web --out-dir ../../pkg-mc-x86-64",
    "build:mc-arm64-wasm": "wasm-pack build ../crates/redextape-mc-wasm --release --target web --out-dir ../../pkg-mc-arm64 -- --no-default-features --features arm64",
    "build:bindings": "bash ../scripts/build-web-bindings.sh",
    "build:app": "vite build",
    "build": "pnpm run build:wasm && pnpm run build:lsp-wasm && pnpm run build:clif-wasm && pnpm run build:mc-x86-wasm && pnpm run build:mc-arm64-wasm && pnpm run build:bindings && pnpm run build:app",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "pnpm run build:bindings && tsc --noEmit",
    "test": "pnpm run build:bindings && vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser --project browser-scrollbars",
    "test:firefox": "REDEXTAPE_FIREFOX=1 VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-6} vitest run --project firefox --project firefox-capture",
    "test:probe:floor": "REDEXTAPE_PROBE=1 vitest run --project browser tests/browser/pane-floor.test.ts",
    "test:probe:lambda-tree": "REDEXTAPE_PROBE=1 vitest run --project browser --reporter=verbose tests/browser/lambda-tree-cost.test.ts",
    "test:probe:lambda-expand-all": "REDEXTAPE_PROBE=1 vitest run --project browser --reporter=verbose tests/browser/lambda-expand-all-cost.test.ts",
    "test:probe:record": "REDEXTAPE_PROBE=1 vitest run --project browser --reporter=verbose tests/browser/record-cost.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/inter": "5.3.0",
    "@fontsource/stix-two-math": "5.3.0",
    "@replit/codemirror-vim": "6.4.0",
    "@types/node": "26.6.6",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "dom-accessibility-api": "0.7.1",
    "hack-font": "3.3.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "web-tree-sitter": "0.27.1"
  }
}

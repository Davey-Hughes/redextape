# Keep the build context small and the image clean.
target/
**/target/
node_modules/
**/node_modules/
web/dist/
# Vitest coverage output. Same reason as web/dist/ above: build output, never an input. It is only
# 600K, but `COPY web/ ./` (`Dockerfile`, in its `web` stage) means any local `pnpm run
# test:coverage` invalidates that layer and every layer after it — including `pnpm run build:app`.
# CI is unaffected (fresh checkout); this is for local builds, which is where the `docker` job's PR
# exemption means the image actually gets exercised.
web/coverage/
# Generated TypeScript for the wasm boundary's wire types. Generated output, never an input to this
# image: stage 2 has no Rust toolchain and so cannot run `build:bindings`, and it does not need to —
# `web/src/types.ts` re-exports the generated types with `import type`, which the bundler erases.
# Excluded so a LOCAL build sees the same absent directory a fresh CI checkout does; leaving it in the
# context would let a developer's already-generated copy hide a stage-2 dependency on Rust.
web/bindings/
pkg/

# Docs, VCS, and local cruft aren't needed to build or run the static site.
.git/
.forgejo/
docs/
**/*.md
scratchpad/
**/*.log
.DS_Store
